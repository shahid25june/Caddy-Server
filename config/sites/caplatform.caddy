# CA Platform
(caplatform) {
	# Its /internal/tls-ask endpoint is for Caddy only, never for visitors.
	respond /internal/* 404
	reverse_proxy caplatform:8080
}

# Main site (platform, super-admin), the default firm and the demo firm — normal automatic certificates.
ca.doctolin.com, cagowhar.doctolin.com, cademo.doctolin.com {
	import caplatform
}

# Firms' own custom domains (added in the CA portal) — list each one here, otherwise it falls
# into the SchoolMS catch-all and shows "isn't configured for any school".
gowharandco.com {
	import caplatform
}

www.gowharandco.com {
	redir https://gowharandco.com{uri} permanent
}

# Firm subdomains ({firm}.ca.doctolin.com) — a certificate on the first visit, once CA Platform
# confirms the firm exists.
*.ca.doctolin.com {
	tls {
		on_demand
	}
	import caplatform
}
